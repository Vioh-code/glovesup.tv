# Server
PORT=
NODE_ENV=

# PostgreSQL
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Login sessions. At least 32 characters. Generate: openssl rand -hex 32
SESSION_SECRET=

# Date of birth encryption key: base64 of 32 bytes. Generate: openssl rand -base64 32
# Back it up outside the repo and the database dumps. Losing it loses every stored DOB.
DOB_ENC_KEY=
