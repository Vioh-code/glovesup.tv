<%# Countdown shared element: t = timeLeft(...) result, suffix optional, due = Date shown as the exact due date (UTC). %>
<span class="time-left<%= t.urgent ? ' time-left--urgent' : '' %>"><%= t.text %><%= !t.expired && locals.suffix ? ' ' + suffix : '' %></span>
<% if (locals.due) { %><time class="time-left" datetime="<%= due.toISOString() %>"><%= dueText(due) %></time><% } %>
