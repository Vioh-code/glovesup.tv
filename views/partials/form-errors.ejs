<% if (locals.errors && errors.length) { %>
      <div class="notice notice--warn" role="alert" style="margin-bottom:var(--space-5)">
        <% if (errors.length === 1) { %><%= errors[0] %><% } else { %>
        <ul><% errors.forEach(function (e) { %><li><%= e %></li><% }) %></ul>
        <% } %>
      </div>
<% } %>
