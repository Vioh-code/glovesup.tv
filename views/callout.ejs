<%- include('partials/top', { title: 'Call out' }) %>
  <%# S-B2 Call out detail (F-C1). Layout: wireframes/pages/callout-respond.html
      Opponent view: Accept and Decline. Creator view: Edit and Cancel.
      "Rating at stake" is hidden until slice 2d (ELO). Battles, record and
      View profile on the opponent card wait for F-F2 and the profile slice. %>
<% const open = b.status === 'proposed';
   const other = role === 'opponent' ? { name: b.challenger_name, elo: b.challenger_elo } : { name: b.opponent_name, elo: b.opponent_elo }; %>
  <main class="page">
    <div class="container container--sm" style="max-width:var(--content-max-width-sm)">
      <p style="margin-bottom:var(--space-3)"><a class="back-link" href="/my-battles">&larr; My battles</a></p>
      <div class="page-head">
        <div>
          <h1><%= role === 'opponent' ? 'Call out from ' + b.challenger_name : 'Call out to ' + b.opponent_name %></h1>
          <p class="page-head__sub"><% if (open) { %><%= role === 'opponent' ? 'Accept or decline. It expires if you don\'t answer in time.' : 'Waiting for your opponent to answer.' %><% } else { %><%= labels.status[b.status] %><% } %></p>
        </div>
<% if (countdown) { %><%- include('partials/time-left', { t: countdown, due: b.expires_at, suffix: role === 'opponent' ? 'to answer' : '' }) %><% } %>
      </div>
<% if (open && !verified && role === 'opponent') { %>
      <div class="notice notice--warn" role="alert" style="margin-bottom:var(--space-5)"><%= notice %></div>
<% } %>
      <section class="card card--accent" aria-labelledby="d">
        <div class="card__head"><h2 class="card__title card__title--sm" id="d">The terms</h2><span class="pill<%= open ? ' pill--action' : '' %>"><%= labels.status[b.status] %></span></div>
        <dl class="dl">
          <dt>Format</dt><dd><%= labels.kind[b.kind] %></dd>
          <dt>Scoring</dt><dd><%= labels.scoring[b.scoring] %></dd>
          <dt>Judging</dt><dd><%= labels.judging[b.judging] %></dd>
<% if (['judging', 'awaiting_panel'].includes(b.status) && b.judging_due_at) { %>
          <dt>Judging due</dt><dd><%- include('partials/time-left', { t: timeLeft(b.judging_due_at), due: b.judging_due_at }) %></dd>
<% } else { %>
          <dt>Videos due</dt><dd><% if (videosDue) { %><%- include('partials/time-left', { t: videosDue, due: b.submissions_due_at }) %><% } else { %><%= b.submission_days %> days after accept<% } %></dd>
<% } %>
        </dl>
<% if (open && role === 'opponent') { %>
        <div class="card__foot">
          <div class="cluster">
<%   if (verified) { %>
            <form method="post" action="/callouts/<%= b.id %>/accept"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><input type="hidden" name="terms_version" value="<%= b.version %>" /><button class="btn btn--primary" type="submit">Accept call out</button></form>
<%   } %>
            <form method="post" action="/callouts/<%= b.id %>/decline"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><button class="btn btn--ghost" type="submit">Decline</button></form>
          </div>
          <p class="hint">Accepting starts the clock for videos<%= b.judging === 'official' ? ' and draws three judges at random' : '' %>.</p>
        </div>
<% } %>
      </section>

      <section class="card" style="margin-top:var(--space-5)">
        <div class="card__head"><h2 class="card__title card__title--sm"><%= role === 'opponent' ? 'Your opponent' : 'Opponent' %>: <%= other.name %></h2></div>
        <div class="stat-row">
          <div class="stat"><span class="stat__label">Rating</span><span class="stat__value"><%= other.elo %></span></div>
        </div>
      </section>

<% if (videos) { %>
      <section class="card" style="margin-top:var(--space-5)" aria-labelledby="vs">
        <div class="card__head"><h2 class="card__title card__title--sm" id="vs">Battle status</h2><a class="btn btn--primary btn--sm" href="/battles/<%= b.id %>/video"><%= videos.mine ? 'Your video' : 'Submit video' %></a></div>
<%- include('partials/video-status', { state: videos, opponent: other.name }) %>
<%   if (videos.mine) { %><%- include('partials/video', { v: videos.mine, label: 'Your video' }) %><% } %>
      </section>
<% } %>

<% if (judges) { %>
      <section class="card" style="margin-top:var(--space-5)" aria-labelledby="panel-h">
        <%# S-B4 Judge panel, a section of the battle page (Matt, Nov 25). Layout: wireframes/pages/judge-panel.html
            Players see each judge's status only (Waiting for reply, Accepted, Judged), never a name or a pick
            (Matt, Nov 25). Read-only, no buttons. Names and picks show on the outcome card after finalize. %>
        <div class="card__head"><h2 class="card__title card__title--sm" id="panel-h">Judge panel</h2></div>
<%   if (judges.length) { %>
        <div class="judge-grid">
<%     judges.forEach(function (j, i) { const ok = j.status !== 'drawn'; %>
          <div class="judge-card judge-card--<%= ok ? 'accepted' : 'waiting' %>"><span class="avatar avatar--crest">J<%= i + 1 %></span><span class="pill <%= ok ? 'pill--success' : 'pill--waiting' %>"><%= j.status === 'scored' ? 'Judged' : (ok ? 'Accepted' : 'Waiting for reply') %></span><% if (!ok) { %><div class="judge-card__meta"><%- include('partials/time-left', { t: timeLeft(j.respond_by), due: j.respond_by, suffix: 'to reply' }) %></div><% } %></div>
<%     }) %>
        </div>
<%   } %>
<%   if (judges.length < panelSize) { %>
        <div class="notice notice--warn"><div class="notice__title">Waiting for judges.</div>Not enough free judges are available right now. The battle waits until more judges are free.</div>
<%   } %>
        <p class="hint">Judges are drawn at random from free judges. Neither side picks, approves or replaces them. Submissions open at acceptance; judging starts once both videos are in and all 3 judges have accepted.</p>
      </section>
<% } %>

<% if (outcome) { %>
<%- include('partials/outcome', { o: outcome }) %>
<% } %>
<%# Missed due date (worker slice, Matt, Nov 25): who missed it and who wins, or void. %>
<% if (b.status === 'forfeited' || b.status === 'voided') {
     const missed = b.forfeited_by === b.challenger_user_id ? b.challenger_name : b.opponent_name;
     const winner = b.result === 'challenger' ? b.challenger_name : b.opponent_name; %>
      <section class="card" style="margin-top:var(--space-5)" aria-labelledby="result-h">
        <div class="card__head"><h2 class="card__title card__title--sm" id="result-h">Result</h2><span class="pill"><%= labels.status[b.status] %></span></div>
<%   if (b.status === 'forfeited') { %>
        <p class="text-secondary"><%= missed %> missed the due date. <%= winner %> wins by forfeit.</p>
<%   } else { %>
        <p class="text-secondary">Neither video came in. The battle is void.</p>
<%   } %>
      </section>
<% } %>

<% if (open && role === 'creator') { %>
      <section class="card" style="margin-top:var(--space-5)">
        <div class="notice"><div class="notice__title">Waiting for <%= b.opponent_name %></div>You can edit or cancel until they accept.</div>
<%   if (!verified) { %>
        <div class="notice notice--warn" role="alert" style="margin-top:var(--space-3)"><%= notice %></div>
<%   } %>
        <div class="card__foot"><div class="cluster">
<%   if (verified) { %>
          <a class="btn btn--ghost" href="/callouts/<%= b.id %>/edit">Edit call out</a>
<%   } %>
          <form method="post" action="/callouts/<%= b.id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><button class="btn btn--danger" type="submit">Cancel call out</button></form>
        </div></div>
      </section>
<% } %>
    </div>
  </main>
<%- include('partials/bottom') %>
